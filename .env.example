APP_NAME=KiemTraDNS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=vi
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_DECAY_SECONDS=60

MEMBERSHIP_DEFAULT_PLAN=free
MEMBERSHIP_SIGNUP_CREDITS=10

RECAPTCHA_ENABLED=false
RECAPTCHA_TYPE=checkbox
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5
RECAPTCHA_EXPECTED_HOSTNAME=
RECAPTCHA_LOGIN_ENABLED=true
RECAPTCHA_LOGIN_ALWAYS_VISIBLE=true
RECAPTCHA_REGISTER_ENABLED=true
RECAPTCHA_PASSWORD_RESET_ENABLED=true
RECAPTCHA_LOGIN_FAILURE_THRESHOLD=2
RECAPTCHA_CONNECT_TIMEOUT_SECONDS=3
RECAPTCHA_TIMEOUT_SECONDS=5
RECAPTCHA_TOKEN_MAX_AGE_SECONDS=120
RECAPTCHA_CLOCK_SKEW_SECONDS=5

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=3900

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
DNS_RDAP_URL="https://rdap.org/domain/"
DNS_GEO_URL="https://ipwho.is/"
DNS_PUBLIC_IP_URL="https://api.ipify.org"
DNS_CACHE_TTL_SECONDS=300
DNS_HTTP_TIMEOUT_SECONDS=5
DNS_HTTP_RESPONSE_MAX_BYTES=1048576
DNS_TRACEROUTE_ENABLED=false
DNS_TRACEROUTE_BINARY=
DNS_TRACEROUTE_TIMEOUT_SECONDS=35
DNS_TRACEROUTE_MAX_OUTPUT_BYTES=65536

RECON_COMPANY_NAME="DNS Recon Security"
RECON_TIMEOUT_SECONDS=10
RECON_CACHE_MINUTES=20
RECON_SUBDOMAIN_CACHE_MINUTES=30
RECON_MAX_SUBDOMAINS=100
RECON_HTTP_RESPONSE_MAX_BYTES=1048576
RECON_CRT_URL="https://crt.sh/"
NMAP_ENABLED=false
NMAP_BINARY="nmap"
NMAP_TIMEOUT_SECONDS=30
NMAP_TOP_PORTS=100
NMAP_MAX_OUTPUT_BYTES=2097152
NMAP_CACHE_MINUTES=15

SCANNER_ALLOWLIST=""
SCANNER_COMPANY_NAME="DNS Recon Security"
SCANNER_MAX_HOSTS=256
SCANNER_MIN_IPV4_PREFIX=24
SCANNER_MIN_IPV6_PREFIX=120
SCANNER_RATE_LIMIT_PER_HOUR=10
SCANNER_SUBMISSION_WINDOW_SECONDS=10
SCANNER_OUTPUT_MAX_BYTES=5242880
SCANNER_TEMPORARY_DISK="local"
SCANNER_NMAP_BINARY="nmap"
SCANNER_ALLOW_PRIVILEGED_PROFILES=false
SCANNER_VULNERABILITY_ENABLED=false
SCANNER_COMPLIANCE_ENABLED=false
NESSUS_ENABLED=false
NESSUS_URL=
NESSUS_ACCESS_KEY=
NESSUS_SECRET_KEY=
NESSUS_TEMPLATE_UUID=
NESSUS_COMPLIANCE_TEMPLATE_UUID=
NESSUS_SCANNER_ID=
NESSUS_FOLDER_ID=
NESSUS_TIMEOUT_SECONDS=30
NESSUS_POLL_INTERVAL_SECONDS=5
NESSUS_RESPONSE_MAX_BYTES=5242880
NESSUS_VERIFY_TLS=true
